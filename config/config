theme = dark:Modus Vivendi Tinted,light:Modus Operandi Tinted

#theme = light:echo-custom-light, dark:echo-custom-dark

font-family = "Berkeley Mono Variable"
#font-family = "Geist Mono"
#font-family = "Departure Mono"
#font-family = "Jetbrains Mono"

#font-family = "0xProto Regular"
#font-family = "Monaspace Neon Var"

font-feature=+calt
font-feature=+ss01
font-feature=+ss02
font-feature=+ss03
font-feature=+ss04
font-feature=+ss05
font-feature=+ss06
font-feature=+ss07
font-feature=+ss08
font-feature=+ss09
font-feature=+ss10
font-feature=+liga

font-size = 18

# font-feature = +calt
